# Shared git settings, linked to ~/.config/git/config. Your identity, SSH
# signing and per-folder includes live in ~/.gitconfig (written by the install
# wizard, read after this file so it wins).

[core]
	excludesfile = ~/.config/git/ignore
	editor = nano
	filemode = false
	trustctime = false
	autocrlf = input
	untrackedCache = true
	pager = diff-so-fancy | less --tabs=4 -RF

[credential]
	helper = osxkeychain

[grep]
	lineNumber = true

[help]
	# Ask before running the command git guesses from a typo
	autocorrect = prompt

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	followTags = true
	# The first push of a branch creates its upstream, no --set-upstream needed
	autoSetupRemote = true

[fetch]
	prune = true

[rebase]
	# Stash uncommitted changes during a rebase, restore them after
	autoStash = true
	# Also move the branches stacked on the rebased one (stacked PRs)
	updateRefs = true

[rerere]
	# Replay how a conflict was resolved when it comes back
	enabled = true

[diff]
	# More readable diffs when code moves or lines repeat
	algorithm = histogram

[merge]
	# Conflicts also show the common ancestor, without lines both sides share
	conflictStyle = zdiff3

[branch]
	# `git branch` lists the most recently active branches first
	sort = -committerdate

[tag]
	# v1.10 after v1.9
	sort = version:refname

[column]
	# Lists in columns when it fits
	ui = auto

[alias]
	amend = commit --amend --reuse-message=HEAD
	br = branch
	ci = commit
	co = checkout
	contrib = shortlog --summary --numbered
	cr = clone --recursive
	df = diff --word-diff
	g = grep --break --heading --line-number
	l = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	ld = "!sh -c \"git log --since '${1:-1} days ago' --oneline --author $(git config user.email)\" -"
	lg = log -p
	ll = log --pretty=oneline --graph --abbrev-commit
	lm = log --pretty=format:'* %s (%h)'
	patch = !git --no-pager diff --no-color
	p = push
	pf = push --force
	pr = "!f() { git fetch -fu ${2:-origin} refs/pull/$1/head:pr/$1 && git checkout pr/$1; }; f"
	show-ignored = "! git clean -ndX | perl -pe 's/Would remove/Ignored:/'"
	st = status
	stl = ls-files -m -o --exclude-standard
	sts = status -sb
	unstage = restore --staged

[color]
	ui = auto
[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green
[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold
[color "status"]
	added = yellow
	changed = green
	untracked = cyan
[color "diff-highlight"]
	oldNormal = red bold
	oldHighlight = red bold 52
	newNormal = green bold
	newHighlight = green bold 22
